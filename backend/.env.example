# ---------------------------------------------------------------
# Copy this file to `.env` and change the values.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# NEVER commit the real .env file to git - it holds secrets.
# ---------------------------------------------------------------

# Port our Express server listens on
PORT=5000

# Node environment: development | production
NODE_ENV=development

# MongoDB connection string
# Local MongoDB:  mongodb://127.0.0.1:27017/webvulnlab
# Atlas cloud   :  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/webvulnlab
MONGO_URI=mongodb://127.0.0.1:27017/webvulnlab

# Comma separated list of origins allowed to call this API (CORS).
# Vite dev server runs on 5173 by default.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
